# Gold El Arby - backend environment template
# Copy to .env and fill in real values. NEVER commit the real .env.

# ---- Server ----
PORT=your_value_here

# ---- Database ----
MONGO_URI=your_value_here

# ---- JWT ----
JWT_SECRET=your_value_here
JWT_REFRESH_SECRET=your_value_here

# ---- Telegram (dedicated gold-price feed account only; NOT customer auth) ----
API_ID=your_value_here
API_HASH=your_value_here
CHANNEL_USERNAME=your_value_here

# Dedicated StringSession for the price-feed poller.
# Keep this value outside the repository. Never commit it.
TELEGRAM_SESSION=your_value_here

# ---- Cloudinary (product image uploads) ----
CLOUDINARY_CLOUD_NAME=your_value_here
CLOUDINARY_API_KEY=your_value_here
CLOUDINARY_API_SECRET=your_value_here
